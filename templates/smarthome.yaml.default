# etc/smarthome.yaml

# Ort: 'Airport Berlin Tegel'
#lat: 52.5588327          # latitude
#lon: 13.2884374          # longitude
#elev: 35                 # elevation

# Ort: 'Weitewelt'
lat: 54.0621869293091    # latitude
lon: 10.4431106741905    # longitude
elev: 30                 # elevation

tz: 'Europe/Berlin'      # timezone, the example will be fine for most parts of central Europe

default_language: de     # default_language is used, where multiple languages are supported (de, if not specified)
#default_logtext: "Item {id} wurde geändert."

# SmartHomeNG looks for the config directories items/structs/logics/scenes/functions
# below the etc directory. Directories found in the SmartHomeNG base directory are moved there on startup.
# Setting this option to false keeps the layout used up to v1.12 (the command line option -e overrides it).
#config_etc: true

# The name of a section in plugin.yaml is the instance name of the plugin.
# Setting this option to true uses the "instance" parameter in plugin.yaml instead (behaviour up to v1.12).
#legacy_instances: false

# 
# control type casting when assiging values to items
# latest or compat_1.2 (compat_1.2 is default for shNG v1.3, latest is default for higher versions)
#assign_compatibility: latest

# If the standard commend PIP3 does not work when multiple Python3 versions are installed
# enter the name or full path of the right pip command below
#pip_command: "python3 -m pip"
#or on Windows platform
#pip_command: "python -m pip"

# Additional directory for modules - is added to sys.path (should not be needed)
#module_paths: /usr/local/python/lib    # list of path-entries is possible

# Crontab entry for querying package versions on PyPI
#shpypi_crontab: '7 3 * *'

# Stem for name of configuration backup files
#backup_name_stem: myinstallation

# Allow the AdminUI to power off or reboot the host (Linux, macOS, Windows).
# The command runs as the user SmartHomeNG runs as - the operating system's
# configuration (polkit, sudoers, ...) decides whether it is permitted.
#allow_system_power: true

# Log a warning with stack trace when a scheduler task (logic, item cycle/crontab,
# plugin scheduler) runs longer than this many seconds, again at each doubling (0 = off).
# Logics can override it with their own 'runtime_warn' parameter in logic.yaml.
#runtime_warn: 120

# Library used to calculate sun and moon: ephem (default), skyfield or skyfield-cached
# (skyfield needs a one-time run of tools/fetch_skyfield_data.py)
#orb_backend: ephem

# Timeout in seconds for database queries (also the lock timeout when closing the connection)
#db_query_timeout: 60

# Name of the file in etc/items (without .yaml) that items created at runtime are written to,
# if no file name is given
#created_items_file: created

# Create items whose name collides with an attribute of the parent object (with a warning)
# instead of dropping them
#ignore_item_collision: false

# Restart SmartHomeNG if the scheduler needs this many worker threads
#restart_on_num_workers: 30

# Allow the experimental item attributes 'trigger' and 'trigger_condition'
#use_conditional_triggers: false

# Order of languages in which texts are searched, if a text is not available in the default language
#fallback_language_order: en,de


#-----------------------------------------
# develop (might be altered for release)
#

# version 1.5 and up:
#
# Loggen von Warnungen, falls abgekündigte Funktionen aufgerufen werden (Standard: False)
#deprecated_warnings: True

# To get info which thread consumes how many cpu when using shng tool 'cpuusage.py'
#threadinfo_export: true

