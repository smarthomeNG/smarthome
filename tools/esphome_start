# Start the ESPHome dashboard (installed by tools/esphome_install) for the configuration
# in <var>/esphome/config. Usage: esphome_start [<var directory>]  (default: <base>/var)

SOURCE=${BASH_SOURCE[0]}
DIR=$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )
SHNG_BASEDIR=$( dirname "$DIR" )
VAR_DIR=${1:-$SHNG_BASEDIR/var}

cd "$DIR"
source act esphome
esphome dashboard "$VAR_DIR/esphome/config"
